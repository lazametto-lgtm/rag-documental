# =============================================================================
# Sistema RAG Documental — Variables de Entorno
# =============================================================================
# Copia este archivo a .env y ajusta los valores.
# cp .env.example .env
# =============================================================================

# --- Base de datos ---
DATABASE_URL=file:./db/custom.db

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cambiar_en_produccion_usa_openssl_rand_hex_32
PORT=3000

# --- Stripe (pagos reales) ---
# 1. Crear cuenta en https://stripe.com
# 2. Dashboard → Developers → API keys → copiar Secret key
STRIPE_SECRET_KEY=

# 3. Dashboard → Developers → Webhooks → Add endpoint
#    URL: https://tudominio.com/api/saas/webhook
#    Eventos: checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
#    Copar el Signing secret
STRIPE_WEBHOOK_SECRET=

# 4. Dashboard → Products → Create product
#    Crear 2 productos: "Pro" ($49/mes) y "Enterprise" ($199/mes)
#    Cada producto necesita un Price con billing cycle monthly
#    Copiar el price_id (price_xxx)
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- Modo Air-Gapped ---
AIR_GAPPED=false

# --- Proveedor LLM ---
LLM_PROVIDER=zai
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LOCAL_SERVER_URL=http://localhost:3031
HYBRID_SERVER_URL=http://localhost:3032
API_URL=https://api.openai.com/v1
API_KEY=
API_MODEL=gpt-4o-mini

# --- Telemetría ---
NEXT_TELEMETRY_DISABLED=1

# --- White-label / Branding (opcional) ---
BRAND_NAME=RAG Documental
BRAND_LOGO_URL=/logo.svg
BRAND_PRIMARY_COLOR=#000000
BRAND_DOMAIN=localhost:3000
BRAND_TAGLINE=Chat con balances, contratos y normativas
BRAND_FOOTER=Powered by Z.ai
BRAND_SUPPORT_EMAIL=support@example.com
