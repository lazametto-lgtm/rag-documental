# =============================================================================
# Sistema RAG Documental — Configuración On-Premise
# =============================================================================
# Copia este archivo a .env y ajusta los valores.
# cp .env.onpremise .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=CambiarEstaPassword123!
DATABASE_URL=postgresql://raguser:CambiarEstaPassword123!@localhost:5432/ragdb?schema=public

# --- Ollama (LLM local con GPU) ---
OLLAMA_MODEL=llama3
# Alternativas: deepseek-r1, qwen2.5, mistral, phi3, llama3.1:8b

# --- LLM Provider ---
# En on-premise: hybrid (fallback local → ollama → api)
LLM_PROVIDER=hybrid
LOCAL_SERVER_URL=http://localhost:3031
HYBRID_SERVER_URL=http://localhost:3032
OLLAMA_URL=http://localhost:11434

# --- API externa (opcional, solo si quieres fallback externo) ---
# Dejar vacío para on-premise puro (100% local)
API_URL=
API_KEY=
API_MODEL=

# --- ChromaDB (vector DB) ---
CHROMA_URL=http://localhost:8000

# --- Air-Gapped ---
AIR_GAPPED=true

# --- Stripe (cobros, opcional en on-premise) ---
# Dejar vacío si no vas a cobrar (licencia on-premise)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=GeneraConOpensslRandHex32

# --- Monitoreo (Grafana) ---
GRAFANA_USER=admin
GRAFANA_PASS=CambiarEstaPassword123!

# --- Telemetría ---
NEXT_TELEMETRY_DISABLED=1

# --- Almacenamiento ---
DOC_STORAGE_PATH=/app/storage/documents
